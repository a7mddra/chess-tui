{
  "name": "chess-tui",
  "version": "0.1.1",
  "type": "module",
  "description": "Play chess.com from your terminal. Real account, real Elo, no ads.",
  "keywords": [
    "chess",
    "tui",
    "terminal",
    "chess.com",
    "ink",
    "cli"
  ],
  "author": "a7mddra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a7mddra/chess-tui.git",
    "directory": "packages/tui"
  },
  "bin": {
    "chess-tui": "bin/chess-tui.mjs",
    "chess": "bin/chess-tui.mjs"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/main.tsx",
    "start": "tsx src/main.tsx",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.1.87",
    "chess.js": "^1.4.0",
    "ink": "^6.8.0",
